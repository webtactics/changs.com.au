    </div>
    {% endif %}

    {% if gallery %}
    <div class="pad2remboth">
      <p><strong>Chang's {{ title }} Product Gallery</strong></p>
      {# Gallery shortcode: {{ gallery }} #}
    </div>
    {% endif %}

    {% if lowercontent %}
    <div class="pad2remboth">
      {{ lowercontent | safe }}
    </div>
    {% endif %}

  </div>

  <div class="CGBlogDetailImage">
    <div align="center">
      <img class="product-detail-image" src="{{ image }}/tr:w-800,h-800,q-90" alt="{{ title | escape }}" title="{{ title | escape }}"/>
    </div>
  </div>

</div>


<!-- product below -->

<div class="padsmall">

  {% if recipes %}
  <div class="recipes-from-products pad2remboth">
    <h4>Recipes featuring Chang's {{ title }}</h4>
    <div class="grid-4-columns recipessummary">
      {% for recipe in recipes %}
      <div class="recipesummarypage">
        <div class="CGBlogSummaryField">
          <a href="{{ recipe.url }}"><img src="{{ recipe.image_url | replace('https://www.changs.com/uploads', 'https://ik.imagekit.io/webtactics/changs-media/recipes') }}/tr:w-400,h-267,q-80" alt="{{ recipe.title | escape }}" title="{{ recipe.title | escape }}"/></a>
        </div>
        <div class="CGBlogSummaryLink">
          <h3><a href="{{ recipe.url }}" title="{{ recipe.title | escape }}">{{ recipe.title }}</a></h3>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <br/>
</div>
