---
layout: layouts/grid-detail.njk
section: post
---

<div class="grid-2-detail-default">

  <div class="recipedetailtitle hide-for-large padsmall">
    <h1>Chang's {{ title }}</h1>
  </div>

  <div class="recipes-ingredients padsmall">

    <div class="recipedetailtitle show-for-large hide-for-small">
      <h1>Chang's {{ title }}</h1>
    </div>

    {% if gtin %}
    <div class="gtin">
      <h3>GTIN: <span class="gtinbold">{{ gtin }}</span></h3>
    </div>
    {% endif %}

    {% if summary %}
    <div class="CGBlogDetailSummary padtop20">
      {{ summary | safe }}
    </div>
    {% endif %}

    {% if content %}
    <div class="CGBlogDetailContent recipelist">
      {{ content | safe }}
    </div>
    {% endif %}

    <!-- start accordion below -->
    <div class="accordion">

      {% if ingredients %}
      <div class="accordion-item">
        <input id="accordion-trigger-1" class="accordion-trigger-input" type="checkbox">
        <label class="accordion-trigger" for="accordion-trigger-1">Product Ingredients</label>
        <section class="accordion-animation-wrapper">
          <div class="accordion-animation">
            <div class="accordion-transform-wrapper">
              <div class="accordion-content">
                {{ ingredients | safe }}
              </div>
            </div>
          </div>
        </section>
      </div>
      {% endif %}

      {% if nutritiontext and not nutrition.EnergyAvgQuantityPerServing %}
      <div class="accordion-item">
        <input id="accordion-trigger-2" class="accordion-trigger-input" type="checkbox">
        <label class="accordion-trigger" for="accordion-trigger-2">Nutritional Information</label>
        <section class="accordion-animation-wrapper">
          <div class="accordion-animation">
            <div class="accordion-transform-wrapper">
              <div class="accordion-content">
                {{ nutritiontext | safe }}
              </div>
            </div>
          </div>
        </section>
      </div>
      {% endif %}

      {% if nutrition.EnergyAvgQuantityPerServing %}
      <div class="accordion-item">
        <input id="accordion-trigger-3" class="accordion-trigger-input" type="checkbox">
        <label class="accordion-trigger" for="accordion-trigger-3">Nutritional Information</label>
        <section class="accordion-animation-wrapper">
          <div class="accordion-animation">
            <div class="accordion-transform-wrapper">
              <div class="accordion-content">
                <div class="CGBlogDetailNutrition">
                  <div class="row">
                    <div class="nutritionservetitle">Product name: {{ title }}{% if prodsize %} ({{ prodsize }}){% endif %}</div>
                  </div>
                  {% if nutrition.servingsperpackage %}
                  <div class="grid-5-7-prod-detail">
                    <div class="nutritiontitle">Serves per pack: {{ nutrition.servingsperpackage }}</div>
                    <div class="nutritiontitle">{% if nutrition.servingsize %}Serve size: {{ nutrition.servingsize }}{% endif %}</div>
                  </div>
                  {% endif %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritionquantity"></div>
                    <div class="nutritionquantity text-center">Quantity<br/>per Serving</div>
                    <div class="nutritionquantity text-right">Quantity<br/>per {% if ml %}100ml{% else %}100g{% endif %}</div>
                  </div>
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Energy</div>
                    <div class="nutritiontitle text-center">{{ nutrition.EnergyAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.EnergyAvgQuantityPer100g %}{{ nutrition.EnergyAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% if nutrition.ProteinAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Protein</div>
                    <div class="nutritiontitle text-center">{{ nutrition.ProteinAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.ProteinAvgQuantityPer100g %}{{ nutrition.ProteinAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.GlutenAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Gluten</div>
                    <div class="nutritiontitle text-center">{{ nutrition.GlutenAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.GlutenAvgQuantityPer100g %}{{ nutrition.GlutenAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.FatAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Fat, total</div>
                    <div class="nutritiontitle text-center">{{ nutrition.FatAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.FatAvgQuantityPer100g %}{{ nutrition.FatAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.FatSaturatedAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">- Saturated</div>
                    <div class="nutritiontitle text-center">{{ nutrition.FatSaturatedAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.FatSaturatedAvgQuantityPer100g %}{{ nutrition.FatSaturatedAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.TransSaturatedAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">- Trans</div>
                    <div class="nutritiontitle text-center">{{ nutrition.TransSaturatedAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.TransSaturatedAvgQuantityPer100g %}{{ nutrition.TransSaturatedAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.PolySaturatedAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">- Polyunsaturated</div>
                    <div class="nutritiontitle text-center">{{ nutrition.PolySaturatedAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.PolySaturatedAvgQuantityPer100g %}{{ nutrition.PolySaturatedAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.MonoSaturatedAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">- Mono</div>
                    <div class="nutritiontitle text-center">{{ nutrition.MonoSaturatedAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.MonoSaturatedAvgQuantityPer100g %}{{ nutrition.MonoSaturatedAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.CholesterolAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Cholesterol</div>
                    <div class="nutritiontitle text-center">{{ nutrition.CholesterolAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.CholesterolAvgQuantityPer100g %}{{ nutrition.CholesterolAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.CarbohydratesAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Carbohydrate</div>
                    <div class="nutritiontitle text-center">{{ nutrition.CarbohydratesAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.CarbohydratesAvgQuantityPer100g %}{{ nutrition.CarbohydratesAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.SugarsAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">- Sugars</div>
                    <div class="nutritiontitle text-center">{{ nutrition.SugarsAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.SugarsAvgQuantityPer100g %}{{ nutrition.SugarsAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutrition.SodiumAvgQuantityPerServing %}
                  <div class="grid-3-prod-detail">
                    <div class="nutritiontitle">Sodium</div>
                    <div class="nutritiontitle text-center">{{ nutrition.SodiumAvgQuantityPerServing }}</div>
                    <div class="nutritiontitle text-right">{% if nutrition.SodiumAvgQuantityPer100g %}{{ nutrition.SodiumAvgQuantityPer100g }}{% endif %}</div>
                  </div>
                  {% endif %}
                  {% if nutritiontext and nutrition.EnergyAvgQuantityPerServing %}
                  <div class="row">
                    <div class="nutritiontitle">{{ nutritiontext | safe }}</div>
                  </div>
                  {% endif %}
                  {% if nuts == false %}
                  <div class="nuts pad1remtopbottom">This product is nut free</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      {% endif %}


      {% if gmo or halal or kosher or additional_origin or origin %}
      <div class="accordion-item">
        <input id="accordion-trigger-4" class="accordion-trigger-input" type="checkbox">
        <label class="accordion-trigger" for="accordion-trigger-4">Additional Information</label>
        <section class="accordion-animation-wrapper">
          <div class="accordion-animation">
            <div class="accordion-transform-wrapper">
              <div class="accordion-content">
                {% if gmo %}
                <div class="CGBlogDetailNutrition">
                  <div class="grid-1-2-prod-detail">
                    <div class="nutritiontitle">GMO Status</div>
                    <div class="nutritiontitle">{{ gmo }}</div>
                  </div>
                </div>
                {% endif %}
                {% if halal %}
                <div class="CGBlogDetailNutrition">
                  <div class="grid-1-2-prod-detail">
                    <div class="nutritiontitle">Halal Status</div>
                    <div class="nutritiontitle">{{ halal }}</div>
                  </div>
                </div>
                {% endif %}
                {% if kosher %}
                <div class="CGBlogDetailNutrition">
                  <div class="grid-1-2-prod-detail">
                    <div class="nutritiontitle">Kosher Status</div>
                    <div class="nutritiontitle">{{ kosher }}</div>
                  </div>
                </div>
                {% endif %}
                {% if additional_origin %}
                <div class="CGBlogDetailNutrition">
                  <div class="grid-1-2-prod-detail">
                    <div class="nutritiontitle">Additional Information:</div>
                    <div class="nutritiontitle">{{ additional_origin }}</div>
                  </div>
                </div>
                {% endif %}
                {% if origin %}
                <div class="CGBlogDetailNutrition">
                  <div class="grid-1-2-prod-detail-noborder">
                    <div class="col-xs-4"><p>Country of origin:</p></div>
                    <div class="col-xs-8"><p>{{ origin }}</p></div>
                  </div>
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </section>
      </div>
      {% endif %}

      {% if allergen %}
      <div class="accordion-item">
        <input id="accordion-trigger-5" class="accordion-trigger-input" type="checkbox">
        <label class="accordion-trigger" for="accordion-trigger-5">Allergen Information</label>
        <section class="accordion-animation-wrapper">
          <div class="accordion-animation">
            <div class="accordion-transform-wrapper">
              <div class="accordion-content">
                {{ allergen | safe }}
                {% if nuts == false %}
                This product is nut free
                {% endif %}
              </div>
            </div>
          </div>
        </section>
      </div>
      {% endif %}

      {% if packsizes %}
      <div class="accordion-item">
        <input id="accordion-trigger-6" class="accordion-trigger-input" type="checkbox">
        <label class="accordion-trigger" for="accordion-trigger-6">Available Pack Sizes</label>
        <section class="accordion-animation-wrapper">
          <div class="accordion-animation">
            <div class="accordion-transform-wrapper">
              <div class="accordion-content">
                This product is available in {{ packsizes }} pack sizes
              </div>
            </div>
          </div>
        </section>
      </div>
      {% endif %}

    </div>
    <!-- end accordion above -->


    {# Buy from buttons — show based on which retailers are flagged true #}
