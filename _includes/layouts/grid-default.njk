{% block redgradient %}
	<div class="redgradient">
		<div class="redgradientcontent">
			<div class="redgradientcontentwrapper">
			<h1 style="text-align:center;" class="text-center white" >{{ title }}</h1>
				<div class="redgradientcontenttextbox">
			<p style="text-align:center;" class="text-center white"> {% if subtitle %}{{ subtitle }}{% else %}{{ description }}{% endif %}</p>
			
				</div>
			</div>
		</div>
	</div>
 {% endblock %} 





    {% block content %}
    <div class="container">
      <main class="content">
       
              <div class="maincontent">{{ content | safe }}</div>
           
        
      </main>
    </div>

    {% endblock %} 
    
    {% block content2 %}{% endblock %} {% block content3 %}{%
    endblock %} {% block ctacontent %}
    <div
      class="section cta-content"
      style="background: url({% if ctaimage %}{{ ctaimage }}{% else %}https://ik.imagekit.io/webtactics/pmfresh/img/1920x953/home-slide-1-1920x953_G3eidXsMb.jpg{% endif %}/tr:w-1920,h-953) no-repeat center center;width:100%; background-size:cover;"
    >
      <div class="content ctabgcontainer">
        <div class="right-cta fade-in">
          <div class="inner">
            <div class="text">
              <div class="titlebox">
                <h3 class="cta-title">
                  {% if ctatitle %}{{ ctatitle }}{% else %}Our Philosophy.{%
                  endif %}
                </h3>
              </div>

              <div class="indent">
                <p>
                  {% if ctatext %}{{ ctatext }}{% else %}We bring the freshest
                  and best quality Australian produce to our consumers while
                  delivering fresh thinking in the food industry.{% endif %}
                </p>
                <div class="linkwrapper">
                  <a
                    class="resultspdf"
                    href="{% if ctalink %}{{ ctalink }}{% else %}/about/our-philosophy/{% endif %}"
                    title="{% if ctatitle %}{{ ctatitle }}{% else %}Our Philosophy.{% endif %}"
                    alt="{% if ctatitle %}{{ ctatitle }}{% else %}Our Philosophy.{% endif %}"
                    >Learn more &gt;</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="pad4rembothwhitebg"></div>
    {% endblock %} {% block newsletter %}
    <div
      class="section emailbg"
      style="
        background: url(https://ik.imagekit.io/webtactics/pmfresh/img/1920x953/our-products-banner-1920x953_of7owdzm3.jpg?updatedAt=1763591097063)
          no-repeat center center;
        width: 100%;
        background-size: cover;
      "
    >
      <div class="content emailbgcontainer">
        <div class="content emailbox">
          <a id="newsletter"><h3 class="emailboxh3">Sign up to our newsletter</h3></a>
          <p class="white">
            Be informed and entertained!<br />Subscribe to our newsletter and
            indulge in mouth-watering recipes, expert tips, exclusive deals, and
            a world of gourmet inspiration delivered straight to your inbox.
          </p>

          <form
            class="js-cm-form"
            id="subForm"
            action="https://www.createsend.com/t/subscribeerror?description="
            method="post"
            data-id="191722FC90141D02184CB1B62AB3DC264B74E952808CB200D8BC61F27AF28712143C55C9F567AA38691DEB3E5E734BAE24819DEA669A3C1D93B6176A2F484E15"
          >
            <div class="grid-5-2-columns">
              <div class="emailbgrowleft">
                <div class="emailbgrowlefttop">
                  <label class="custom-field" aria-label="Enter your name">
                    <input
                      class="emailbginput"
                      id="fieldName"
                      maxlength="200"
                      name="cm-name"
                      placeholder="Your name"
                      required=""
                      onfocus="if(this.value==this.defaultValue) this.value='';"
                      onblur="if(this.value=='') this.value=this.defaultValue;"
                      type="text"
                    />
                  </label>
                </div>
                <div class="emailbgrowleftbottom">
                  <label
                    class="custom-field"
                    aria-label="Enter your email address"
                  >
                    <input
                      autocomplete="Email"
                      class="js-cm-email-input qa-input-email emailbginput"
                      id="fieldEmail"
                      maxlength="200"
                      name="cm-ttululd-ttululd"
                      placeholder="Enter your email address"
                      required=""
                      type="email"
                    />
                  </label>
                </div>
                <div class="hidden emailhidden">
                  <label
                    class="custom-field"
                    aria-label="Confirm your email address"
                  >
                    <input
                      class="hidden emailbginput"
                      id="fieldtyflhl"
                      maxlength="200"
                      name="cm-f-tyflhl"
                      type="text"
                      placeholder="Enter your email address"
                    />
                  </label>
                </div>
              </div>
              <div class="emailbgrowright">
                <button
                  class="success fullwidth"
                  type="submit"
                  title="Sign up to our newsletter"
                  alt="Sign up to our newsletter"
                >
                  Subscribe
                </button>
                <script
                  type="text/javascript"
                  src="https://js.createsend1.com/javascript/copypastesubscribeformlogic.js"
                ></script>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
    {% endblock %}



