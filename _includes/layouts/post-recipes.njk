---
layout: layouts/grid-detail.njk
section: post
---


<div class="grid-2-detail-default">

<div class="recipedetailtitle hide-for-large padsmall">
<h1>{{ title }}</h1>
</div>

<div class="recipeDetailimage">
<img align="center" class="lightbox-image centerimg" src="{{ image }}/tr:w-750,h-1000" alt="{{ title }}" title="{{ title }}" />
</div>

<div class="recipes-ingredients padsmall">

<div class="recipedetailtitle show-for-large hide-for-small">
<h1>{{ title }}</h1>
</div>


<div class="recipedetailserveprepdifficultbox">
{% if serves %}
  <div class="recipedetailserveprepdifficult">
      <span class="reddetail">Serves:</span>{{ serves }}
  </div>
{% endif %}
{% if makes %}
  <div class="recipedetailserveprepdifficult">
      <span class="reddetail">Makes:</span>{{ makes }}
  </div>
{% endif %}
{% if preptime %}
  <div class="CGBlogDetailSummary">
    <span class="reddetail">Preparation time:</span>{{ preptime }}
  </div>
{% endif %}
{% if cookingtime %}
  <div class="CGBlogDetailSummary">
    <span class="reddetail">Cooking time:</span>{{ cookingtime }}
  </div>
{% endif %}
{% if marinating %}
  <div class="CGBlogDetailSummary">
    <span class="reddetail">Marinating time:</span>{{ marinating }}
  </div>
{% endif %}
{% if difficulty %}
  <div class="CGBlogDetailSummary">
    <span class="reddetail">Difficulty:</span>{{ difficulty }}
 </div>
{% endif %}
</div>

{% if content %}
<div class="CGBlogDetailContent recipelist">
{{ content | safe }}
</div>
{% endif %}



{% if ingredients %}
<div class="CGBlogDetailContent recipelist">
{{ ingredients | safe }}
</div>
{% endif %}






</div>
</div>
<!-- method below -->

<div class="recipes-ingredients padsmall">
{% if method %}
<div class="CGBlogMethod recipelist">
{{ method | safe }}
</div>
{% endif %}


{% set relatedProducts = collections.Products | productsFromTags(tags) | sortAlphabetically("title") %}
{% if relatedProducts.length %}
<div class="componenth3 relatedProducts">
  <h3>Relevant products</h3>
  <div id="relevant-products" class="relevant-products">
   {% set postslist = relatedProducts %}
   {% include "components/postlist/postslist-products-6-wide-related-from-recipes.njk" %}
   </div>
   </div>
{% endif %}



{% if video %}
<div class="componenth3 recipesvideocontent">
<h3>Making {{ title }} in 30 seconds!</h3>


{% if videoportrait %}
<div class="legacy-portrait-container">
  <iframe src="{{ video | safe }}?autoplay=false&loop=false&muted=false&preload=true" loading="lazy" style="border:0;position:absolute;top:0;height:100%;width:100%;" allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;" allowfullscreen="true"></iframe>
  </div>
{% else %}

<div style="position:relative;padding-top:100%;">
  <iframe src="{{ video | safe }}?autoplay=false&loop=false&muted=false&preload=true" loading="lazy" style="border:0;position:absolute;top:0;height:100%;width:100%;" allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;" allowfullscreen="true"></iframe>
  </div>
{% endif %}

</div>


{% endif %}
{% if youtube %}
<div class="recipesvideocontent pad2remtopbottom">
<div class="embed-responsive embed-responsive-16by9">
 <iframe id="video" class="embed-responsive-item" src="{{ youtube }}"  frameborder="0" allowfullscreen></iframe>
</div>
</div>

{% endif %}



{% if galleryimages %}
<div class="componenth3 gallerypics">
{% if headinggalleryimages %}<h3>{{ headinggalleryimages }}</h3>{% endif %}
{% set galleryFolder = galleryimages %}
{% include "components/gallery-folder8.njk" %}
</div>
{% endif %}

{% if tags %}
<div class="componenth3 tagged">
  <h3>Recipe Tags</h3>
{% include "components/global/tagged.html" %}
</div>
{% endif %}


<div class="componenth3 more-recipes fade-in">
<h3>More Recipes we like:</h3>
{% set postslist = collections['Recipes']  |  randomLimit(4, page.url)  %} 
{% include "components/postlist/postslist-recipes-4-wide.njk" %}
<div class="pad3rem text-leftflex">
  <a class="button success  black" href="/recipes/" title="More Recipes" alt="More Recipes">View All Recipes &gt;</a>
</div>
</div>

<!-- end method below -->
</div>