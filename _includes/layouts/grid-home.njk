{% extends "layouts/grid-default.njk" %}


{% block hero %}
 
{% include "components/grid-hero.njk" %}

{% endblock %}

    {% block redgradient %}
      <div class="redgradient">
        <div class="redgradientcontent">
          <div class="redgradientcontentwrapper">
            <h1 style="text-align:center;" class="text-center white">{{ title }}</h1>
            <div class="redgradientcontenttextbox">
              <p style="text-align:center;" class="text-center white">{% if subtitle %}{{ subtitle }}{% else %}{{ description }}{% endif %}</p>
            </div>
          </div>
        </div>
      </div>
    {% endblock %}






{% block content2 %}

<div class="container">

	<div class="content home">

		<div class="changs-house">
    		<img src="https://ik.imagekit.io/webtactics/changs-media/assets/icons/changs-bowl_pyS8wDFp1.png?updatedAt=1711837496199" alt="Chang's Flavours of Asia" title="Chang's Flavours of Asia" width="106px" height="79px">
		</div>

		<h3 class="text-center">Latest Recipes</h3>
          
		{% set postslist = collections['Latest-Recipes'] | reverse | limit(3)  %} 
		{% include "components/postlist/postslist-recipes-3-wide.njk" %}

		<div class="wtbbox4">
    		<div class="wtbboxwrapper">
         		<div class="text-centerflex">
            		<a href="/recipes/" class="button success" title="View all recipes" alt="View all recipes">View all recipes</a>
        		</div>
    		</div>
		</div>

	</div>

</div>

{% endblock %}