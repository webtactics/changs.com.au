{% extends "layouts/grid-default.njk" %}


{% block content %}

<div class="container">

    <main class="content sidebar" data-pagefind-body>
        <img src="{{ image or metadata.image }}" alt="" data-pagefind-meta="image[src]" style="display:none">

        <div class="grid-2-sidebar">
			
			<div class="maincontent contentleft">
				{{ content | safe }}
			</div>
			<div class="sidebarcontent">
				{% set postslist = collections['Gluten Free Product'] | intersection(collections['Products']) |  randomLimit(3, page.url)  %}
				{% include "components/postlist/postslist-products-sidebar.njk" %}
			</div>
		</div>

		
    </main>
</div>

{% endblock %}