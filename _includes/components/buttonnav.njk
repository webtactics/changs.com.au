    {title: "Gluten Free Products", url: "/products/gluten-free-products/"},
    {title: "Tamari Wheat Free Sauces", url: "/products/tamari-wheat-free-sauces/"}
  ],
  recipes: [
    {title: "Main Ingredient", url: "/recipes/main-ingredient/"},
    {title: "Soup & Salad", url: "/recipes/soup-salad/"},
    {title: "Quick and Easy", url: "/recipes/quick-and-easy/"},
    {title: "Stir-fry", url: "/recipes/stir-fry/"},
    {title: "Main Meals", url: "/recipes/main-meals/"},
    {title: "Gluten Free Recipes", url: "/recipes/gluten-free-recipes/"},
    {title: "Desserts", url: "/recipes/desserts/"}
  ],
  mainingredient: [
    {title: "Vegetarian", url: "/recipes/main-ingredient/vegetarian/"},
    {title: "Noodles", url: "/recipes/main-ingredient/noodles/"},
    {title: "Seafood", url: "/recipes/main-ingredient/seafood/"},
    {title: "Poultry", url: "/recipes/main-ingredient/poultry/"},
    {title: "Pork", url: "/recipes/main-ingredient/pork/"},
    {title: "Lamb", url: "/recipes/main-ingredient/lamb/"},
    {title: "Beef", url: "/recipes/main-ingredient/beef/"}
  ],
  poultry: [
    {title: "Poultry", url: "/recipes/main-ingredient/poultry/"},
    {title: "Chicken", url: "/recipes/main-ingredient/poultry-recipes/chicken/"},
    {title: "Duck", url: "/recipes/main-ingredient/poultry-recipes/duck/"},
    {title: "Turkey", url: "/recipes/main-ingredient/poultry-recipes/turkey/"}
  ],
  seasonal: [
    {title: "Seasonal", url: "/recipes/seasonal/"},
    {title: "Festive", url: "/recipes/seasonal/festive/"},
    {title: "Spring", url: "/recipes/seasonal/spring/"},
    {title: "Summer", url: "/recipes/seasonal/summer/"},
    {title: "Autumn", url: "/recipes/seasonal/autumn/"},
    {title: "Winter", url: "/recipes/seasonal/winter/"}
  ],
  dishtype: [
    {title: "Dinner for Two", url: "/recipes/dish-type/dinner-for-two/"},
    {title: "Sweet Treats", url: "/recipes/dish-type/sweet-treats/"},
    {title: "Light Bites", url: "/recipes/dish-type/light-bites/"},
    {title: "Healthy Meals", url: "/recipes/dish-type/healthy-meals/"},
    {title: "Dairy Free", url: "/recipes/dish-type/dairy-free/"},
    {title: "Starters", url: "/recipes/dish-type/starters/"},
    {title: "BBQ", url: "/recipes/dish-type/bbq/"}
  ],
  whychangs: [
    {title: "About Us", url: "/why-changs/"},
    {title: "Sustainability", url: "/why-changs/sustainability/"},
    {title: "Privacy Policy", url: "/why-changs/privacy-policy/"}
  ],
    contact: [
   {title: "Contact", url: "/contact/"},
    {title: "Products", url: "/products/"},
    {title: "Recipes", url: "/recipes/"}
  ],
  changstv: [
   {title: "Chang's TV", url: "/changs-tv/"},
    {title: "Products", url: "/products/"},
    {title: "Recipes", url: "/recipes/"}
  ]
} %}

{% set url = page.url %}

{% if url.startsWith("/products/") %}
  {% set navItems = buttonnavGroups.products %}
{% elif url.startsWith("/recipes/main-ingredient/poultry") %}
  {% set navItems = buttonnavGroups.poultry %}
{% elif url.startsWith("/recipes/main-ingredient/") %}
  {% set navItems = buttonnavGroups.mainingredient %}
{% elif url.startsWith("/recipes/dish-type/") %}
  {% set navItems = buttonnavGroups.dishtype %}
{% elif url.startsWith("/recipes/seasonal") %}
  {% set navItems = buttonnavGroups.seasonal %}
{% elif url.startsWith("/why-changs/") %}
  {% set navItems = buttonnavGroups.whychangs %}
{% elif url.startsWith("/changs-tv/") %}
  {% set navItems = buttonnavGroups.changstv %}
  {% elif url.startsWith("/contact/") %}
  {% set navItems = buttonnavGroups.contact %}
{% elif url.startsWith("/recipes/") %}
  {% set navItems = buttonnavGroups.recipes %}
{% else %}
  {% set navItems = [] %}
{% endif %}

{% if navItems.length %}
{% set currentInGroup = false %}
{% for item in navItems %}{% if url == item.url %}{% set currentInGroup = true %}{% endif %}{% endfor %}
<div class="container">
  <div class="content buttonnavbox hide-for-small">
    <div class="buttonnav hide-for-small">
      <div class="buttonnavwrapper">
        {% for item in navItems %}
        <button class="{% if url == item.url %}currentpage{% endif %}"><a class="{% if url == item.url %}currentpage{% endif %}" href="{{ item.url }}" title="{{ item.title }}">{{ item.title }}</a></button>
        {% endfor %}
      </div>
    </div>
  </div>

<div class="content selectnavbox hide-for-large">
    <div class="selectboxwrapper hide-for-large">
      <p>Check out our section below, or narrow your search using one of the selector options.</p>
      <div class="selectbox">
        <select name="forma" onchange="location = this.value;">
          <option disabled="disabled" {% if not currentInGroup %}selected="selected"{% endif %} value="">-- Select Section --</option>
          {% for item in navItems %}
          <option value="{{ item.url }}" {% if url == item.url %}selected="selected"{% endif %}>{{ item.title }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
  </div>
</div>
{% endif %}
