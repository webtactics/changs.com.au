{% set folderImages = galleryFolder | getImagesFromFolder %}
{% if folderImages.length %}
<div class="grid-8-gallery">
{% for img in folderImages %}
<div class="galleryimgwrapper">


<a class="group" href="https://ik.imagekit.io/webtactics/changs/img/recipes/{{ image.url }}" alt="{{ title }}" title="{{ title }}" data-title="{{ title }}" data-lightbox="{{ title }}">
<img src="https://ik.imagekit.io/webtactics/changs/img/recipes/{{ image.url }}?tr=w-300,h-300,q-70,pr-true" alt="{{ title }}" title="{{ title }}"></a>


</div>
{% endfor %}
</div>
{% endif %}
