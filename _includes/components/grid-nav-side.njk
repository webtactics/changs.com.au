{% set navPages = collections.all | eleventyNavigation %}
  {% macro containsActive(entry) -%}
  {%- if entry.url == page.url -%}1{%- else -%}
  {%- set found = false -%}
  {%- for child in entry.children -%}
  {%- if containsActive(child) == "1" -%}{%- set found = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if found -%}1{%- else -%}0{%- endif -%}
  {%- endif -%}
  {%- endmacro %}

  {% macro renderNavListItem(entry) -%}
  {% set isOpen = containsActive(entry) == "1" %}
  <li class="nav-item{% if entry.children.length %} has-children{% endif %}{% if isOpen %} open{% endif %}{% if entry.url == page.url %} menuactive{% endif %}">
    <div class="nav-item-row">
    {% if entry.noLink %}
    <span class="nav-section-header{% if entry.children.length %} nav-accordion-toggle{% endif %}"{% if entry.children.length %} aria-expanded="{{ 'true' if isOpen else 'false' }}"{% endif %}>{{ entry.title }}</span>
    {% else %}
    <a href="{{ entry.url }}" title="{{ entry.title }}" alt="{{ entry.title }}">{{ entry.title }}</a>
    {% if entry.children.length %}
    <button type="button" class="nav-accordion-toggle" aria-expanded="{{ 'true' if isOpen else 'false' }}" aria-label="Toggle {{ entry.title }} menu"></button>
    {% endif %}
    {% endif %}
    </div>
 {% if entry.url == "/contact/thank-you/" %}
<li class="hide"><a href="/contact/thank-you/" title="" alt=""></a></li>
{% endif %}
    {% if entry.children.length %}
      <ul class="second">
        {% for child in entry.children %}
          {{ renderNavListItem(child) }}
        {% endfor %}
      </ul>
    {% endif %}

</li>
  {%- endmacro %}

<ul class="off-canvas-list">
<li><a href="/" title="Home" alt="Home">Home</a></li>
{% if not entry.hide %}
{%- for entry in navPages %}{{ renderNavListItem(entry) }}{%- endfor -%}
{% endif %}
<li><a href="/contact/" title="Contact" alt="Contact">Contact</a></li>
<li><a href="/newsletter/" title="Join Newsletter" alt="Join Newsletter">Join Newsletter</a></li>
</ul>

